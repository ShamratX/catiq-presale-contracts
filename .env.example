# Copy this file to `.env` and fill in your values.
# Never commit `.env` — it is listed in .gitignore.

# -----------------------------------------------------------------------------
# Hardhat / network
# -----------------------------------------------------------------------------

# Deployer wallet private key (no 0x prefix required by Hardhat, but 0x is fine)
PRIVATE_KEY=

# BSC RPC endpoints (e.g. from Ankr, QuickNode, or public nodes)
BSC_MAINNET_RPC_URL=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# BscScan API key for contract verification
# https://bscscan.com/myapikey
BSCSCAN_API_KEY=

# -----------------------------------------------------------------------------
# CatIQ token deployment (scripts/deploy-catiq.js, scripts/args.js)
# -----------------------------------------------------------------------------

# Public presale allocation wallet (receives 250M CIQ at deploy)
PP_WALLET=0x0000000000000000000000000000000000000000

# Reserve wallets (each receives 150M CIQ at deploy)
EXCHANGE_WALLET=0x0000000000000000000000000000000000000000
TREASURY_WALLET=0x0000000000000000000000000000000000000000
MARKETING_WALLET=0x0000000000000000000000000000000000000000
TEAM_WALLET=0x0000000000000000000000000000000000000000
DEV_WALLET=0x0000000000000000000000000000000000000000

# -----------------------------------------------------------------------------
# Presale deployment (scripts/deploy-presale.js, scripts/presale-args.js)
# -----------------------------------------------------------------------------

# Deployed CatIQ token address
CATIQ_ADDRESS=0x0000000000000000000000000000000000000000

# Chainlink BNB/USD price feed
# BSC mainnet: 0x0567F2323251f0Aab15c8dFb1967E4e8A7D42aeE
# BSC testnet: 0x2514895c72f50D8bd4B4F9b1110f0D6bD2c97526
BNB_USD_PRICE_FEED=0x0000000000000000000000000000000000000000

# Token price per stage in USD with 8 decimals (e.g. $0.01 = 1000000)
PRESALE_USD_PRICE_STAGE1=1000000
PRESALE_USD_PRICE_STAGE2=2000000
PRESALE_USD_PRICE_STAGE3=3000000

# Unix timestamps in seconds (PRESALE_START_TIME < PRESALE_END_TIME <= PRESALE_TGE_TIME)
PRESALE_START_TIME=0
PRESALE_END_TIME=0
PRESALE_TGE_TIME=0
